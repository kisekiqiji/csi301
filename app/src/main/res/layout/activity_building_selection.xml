<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:fitsSystemWindows="true" android:background="#F7F8F2">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize" android:background="#F7F8F2" app:title="选择楼栋" app:navigationIcon="?attr/homeAsUpIndicator"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="20dp"
        android:layout_marginTop="10dp" android:text="下一站，去哪里学习？" android:textStyle="bold" android:textSize="24sp" android:textColor="#283527"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="20dp"
        android:layout_marginTop="7dp" android:text="按校区找楼栋，选择一处看看。" android:textSize="12sp" android:textColor="#74806D"/>
    <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/toggle_building_scope"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="18dp" android:layout_marginTop="16dp"
        app:singleSelection="true" app:selectionRequired="true">
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_building_rooms" style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="教室"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_building_public" style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="公共空间"/>
    </com.google.android.material.button.MaterialButtonToggleGroup>
    <com.google.android.material.button.MaterialButton android:id="@+id/btn_all_buildings" style="?attr/materialButtonOutlinedStyle"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="18dp"
        android:text="全部楼栋 · 跨楼查询" app:cornerRadius="12dp"/>
    <TextView android:id="@+id/tv_building_status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingHorizontal="22dp" android:paddingVertical="6dp" android:text="正在读取楼栋目录…" android:textSize="11sp" android:textColor="#74806D"/>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_buildings" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingHorizontal="12dp" android:paddingBottom="20dp"/>
</LinearLayout>
